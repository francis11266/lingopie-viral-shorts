# Copy this file to ".env" and paste the two keys. Only the person who DEPLOYS
# the app needs these; teammates just use the web page.

# ElevenLabs (voiceover). Get a key at https://elevenlabs.io  ->  Profile -> API Keys
ELEVENLABS_API_KEY=

# Default narrator voice (a real ElevenLabs voice_id). Adam = deep American male.
# The web app's Voice dropdown can override this per video.
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Anthropic (Claude picks the scene + the 3 beginner words). https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
